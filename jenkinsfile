pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  containers:
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command:
    - /busybox/cat
    tty: true
    env:
    - name: AWS_DEFAULT_REGION
      value: "us-east-1"
  - name: kubectl
    image: 150916258276.dkr.ecr.us-east-1.amazonaws.com/aws-kubectl:latest
    command:
    - /bin/sh
    args:
    - -c
    - sleep 99d
"""
        }
    }
    environment {
        REGISTRY = '150916258276.dkr.ecr.us-east-1.amazonaws.com'
        EXCHANGE = "${REGISTRY}/exchange"
        CONVERSION = "${REGISTRY}/conversion"
        DOCKER_CONFIG = '/kaniko/.docker/'
        GIT_URL = 'https://github.com/vivek-infra-automation/microservices.git'
        COMMIT_ID = ''
        BRANCH = "${params.Build_Identity}"
        GITHUB_CREDENTIALS_ID = 'github-ssh-key'
        APPLICATION = "${params.Delivery}"
    }
    parameters {
        string(
            description: 'Branch name or commit ID to build',
            name: 'Build_Identity',
            defaultValue: 'master',
            trim: true
        )
        choice(
            name: 'Delivery',
            choices: ['exchange', 'conversion'],
            description: 'Select the microservice to deploy'
        )
    }
    stages {
        stage('Checkout') {
            steps {
                script {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: BRANCH]],
                        userRemoteConfigs: [[
                            url: GIT_URL,
                            credentialsId: GITHUB_CREDENTIALS_ID
                        ]]
                    ])
                    COMMIT_ID = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                }
            }
        }

        stage('Build Application') {
            steps {
                container('kaniko') {
                    script {
                        def image = ""
                        if (APPLICATION == 'exchange') {
                            image = "${EXCHANGE}:${COMMIT_ID}"
                            sh """
                            /kaniko/executor \
                                --dockerfile 01-currency-exchange-microservice-basic/Dockerfile \
                                --context ${env.WORKSPACE}/01-currency-exchange-microservice-basic \
                                --destination ${image}
                            """
                        } else if (APPLICATION == 'conversion') {
                            image = "${CONVERSION}:${COMMIT_ID}"
                            sh """
                            /kaniko/executor \
                                --dockerfile 02-currency-conversion-microservice-basic/Dockerfile \
                                --context ${env.WORKSPACE}/02-currency-conversion-microservice-basic \
                                --destination ${image}
                            """
                        }
                    }
                }
            }
        }

        stage('Update and Deploy') {
            steps {
                container('kubectl') {
                    script {
                        def image = (APPLICATION == 'exchange') ? "${EXCHANGE}:${COMMIT_ID}" : "${CONVERSION}:${COMMIT_ID}"
                        echo "Deploying ${APPLICATION} with image ${image}"
                        sh """
                            aws eks update-kubeconfig --name eks-cluster-1-31 --region us-east-1
                            sed -i "s|image: .*|image: ${image}|" k8s/${APPLICATION}.yaml
                            kubectl apply -f k8s/${APPLICATION}.yaml --validate=false
                        """
                    }
                }
            }
        }
    }
}